// Flush stdout/stderr to completion BEFORE exit — process.exit() fires while a
// large async pipe write is still buffered, silently truncating piped output at
// the 8192-byte pipe buffer (observed: `oas ... | jq` parse errors; `> file`
// unaffected). All code-path exits must go through finish(). (LSL 2026-09-04)
async function writeOut(stdout: string, stderr: string, exitCode: number): Promise<void> {
  // NEVER exit on a process.stdout.write callback: in Bun 1.3.11 the callback
  // can fire while megabyte-scale pipe writes are still buffered (measured:
  // 139,910B JSON → 8,192B in pipe; nondeterministic; `> file` always fine).
  // Bun.write(Bun.stdout) awaits FULL flush (verified deterministic 13/13 runs).
  if (stderr.length > 0) process.stderr.write(stderr);
  if (stdout.length > 0) await Bun.write(Bun.stdout, stdout);
  process.exit(exitCode);
}

function finish(exitCode: number): void {
  // For paths using stdio "inherit" (TUI/spawn) — nothing to flush ourselves.
  process.exit(exitCode);
}

// ============================================================================
// Config Loading
// ============================================================================

function getDefaultConfig(): Config {
  return {
    agents: [
      {
        agent: "opencode",
        alias: "default",
        enabled: true,
        storage: { mode: "auto" },
      },
    ],
  };
}

// Completion cannot terminate the caller or emit diagnostics on a malformed config.
function loadCompletionConfig(): Config {
  const paths = [
    join(process.cwd(), "oas.config.yaml"),
    join(process.cwd(), "oas.config.yml"),
    join(homedir(), ".config", "oas", "config.yaml"),
    join(homedir(), ".config", "oas", "config.yml"),
  ];
  for (const path of paths) {
    if (!existsSync(path)) continue;
    try { return loadConfigFromFile(path); }
    catch { return { agents: [] }; }
  }
  return getDefaultConfig();
}

function loadConfig(): Config {
  // Try to load from default config path
  const configPaths = [
    join(process.cwd(), "oas.config.yaml"),
    join(process.cwd(), "oas.config.yml"),
    join(homedir(), ".config", "oas", "config.yaml"),
    join(homedir(), ".config", "oas", "config.yml"),
  ];

  for (const path of configPaths) {
    if (existsSync(path)) {
      try {
        return loadConfigFromFile(path);
      } catch (error) {
        console.error(`Failed to load config from ${path}: ${error instanceof Error ? error.message : String(error)}`);
        process.exit(1);
      }
    }
  }

  // Return default config if no config file found
  return getDefaultConfig();
}

// ============================================================================
// Service Creation
// ============================================================================

/**
 * Returns factory functions for all supported agent types.
 * Codex/claude adapters use the `path` field from config, if present.
 */
function createAllAgentFactories(cwd: string) {
  return {
    opencode: (entry: AgentEntry) => createOpenCodeAdapter(entry as any, { cwd }),
    codex: (entry: AgentEntry) => createCodexAdapter(entry as any, { defaultPath: (entry as any).path }),
    claude: (entry: AgentEntry) => createClaudeAdapter(entry as any, {}),
    hermes: (entry: AgentEntry) => createHermesAdapter(entry as any),
    gemini: (entry: AgentEntry) => createGeminiAdapter(entry as any),
    antigravity: (entry: AgentEntry) => createAntigravityAdapter(entry as any),
    pi: (entry: AgentEntry) => createPiAdapter(entry as any, {}),
    zcode: (entry: AgentEntry) => createZcodeAdapter(entry as any),
    grok: (entry: AgentEntry) => createGrokAdapter(entry as any),
  };
}

function createSessionsService(config: Config): SessionsService {
  const registry = createAdapterRegistry(config, createAllAgentFactories(process.cwd()));

  return async (query: SessionsQuery) => {
    const errors: { agent: string; alias: string; message: string }[] = [];

    // Restrict sources before querying: unselected agents can be slow or broken.
    const matchingAdapters = registry.adapters.filter((adapter) =>
      (query.agent === undefined || adapter.agent === query.agent) &&
      (query.alias === undefined || adapter.alias === query.alias)
    );
    const promises = matchingAdapters.map(async (adapter) => {
      try {
        if (adapter.listSessionsByTimeRange) {
          return await adapter.listSessionsByTimeRange(query.timeRange);
        } else {
          // Fallback to listSessions if time range not supported
          const sessions = await adapter.listSessions();
          // Apply time filtering manually
          return sessions.filter((s) => {
            const updated = Date.parse(s.updated_at);
            if (query.timeRange.since !== undefined && updated < query.timeRange.since) {
              return false;
            }
            if (query.timeRange.until !== undefined && updated > query.timeRange.until) {
              return false;
            }
            return true;
          });
        }
      } catch (error) {
        errors.push({
          agent: adapter.agent,
          alias: adapter.alias,
          message: error instanceof Error ? error.message : String(error),
        });
        return [];
      }
    });

    const sessionLists = await Promise.all(promises);
    let results = sessionLists.flat();

    // Post-filter by agent/alias (defense-in-depth)
    if (query.agent !== undefined) {
      results = results.filter((s) => s.agent === query.agent);
    }
    if (query.alias !== undefined) {
      results = results.filter((s) => s.alias === query.alias);
    }

    // Sort by updated_at descending
    results.sort((a, b) => Date.parse(b.updated_at) - Date.parse(a.updated_at));

    // Apply limit
    const limit = query.timeRange.limit ?? 50;
    const limited = limit > 0 ? results.slice(0, limit) : results;

    return { sessions: limited, errors };
  };
}

function createReadService(config: Config): ReadService {
  const registry = createAdapterRegistry(config, createAllAgentFactories(process.cwd()));

  return async (query: { agent: string; alias: string; id: string }, options: SessionReadOptions) => {
    const adapter = registry.adapters.find(
      (a) => a.agent === query.agent && a.alias === query.alias
    );

    if (!adapter || !adapter.getSessionDetail) {
      return null;
    }

    // Prefer exact IDs. Only resolve prefixes after a definitive "not found":
    // storage errors must not be misreported as an unknown/ambiguous session.
    let notFoundError: unknown;
    try {
      const exact = await adapter.getSessionDetail(query.id, options);
      if (exact) return exact;
    } catch (error) {
      if (!/session not found/i.test(error instanceof Error ? error.message : String(error))) {
        throw error;
      }
      notFoundError = error;
    }

    // The CLI documents abbreviated IDs (e.g. 34da877b for ses_34da877b...).
    // Resolve within the already selected agent+alias, never choose a random hit.
    const matches = (await adapter.listSessions())
      .filter((session) => session.id.startsWith(query.id) ||
        session.id.startsWith(`ses_${query.id}`))
      .map((session) => session.id);
    const unique = [...new Set(matches)].sort();
    if (unique.length > 1) {
      throw new Error(`Ambiguous session ID "${query.id}". Matches: ${unique.join(", ")}. Specify the full ID.`);
    }
    if (unique.length === 1) {
      return adapter.getSessionDetail(unique[0], options);
    }
    if (notFoundError) throw notFoundError;
    return null;
  };
}

function createSearchService(config: Config): SearchService {
  const factories = createAllAgentFactories(process.cwd());
  return async (query: SearchQuery) => {
    const errors: { agent: string; alias: string; message: string }[] = [];

    // BUG-2 companion: --agent/--alias scopes the fan-out to one adapter —
    // the full cross-agent scan can take minutes (pi alone is 15GB).
    const targets = config.agents.filter((e) => e.enabled && (!query.agent || e.agent === query.agent) && (!query.alias || e.alias === query.alias));
    if (query.agent && targets.length === 0) {
      return { sessions: [], errors: [{ agent: query.agent, alias: query.alias ?? "", message: `Agent "${query.agent}" is not enabled in config` }] };
    }

    const promises = targets.map(async (entry) => {
      try {
        // R-19: cross-agent search — use the shared factory map so every agent
        // kind is searchable (the old hardcoded chain missed antigravity/gemini/
        // zcode/hermes → RCA 2026-09-02).
        const factory = factories[entry.agent];
        if (!factory) return [];
        const adapter = factory(entry);

        if (adapter && adapter.searchSessions) {
          return await adapter.searchSessions(query);
        }
        return [];
      } catch (error) {
        errors.push({
          agent: entry.agent,
          alias: entry.alias,
          message: error instanceof Error ? error.message : String(error),
        });
        return [];
      }
    });

    const sessionLists = await Promise.all(promises);
    const results = sessionLists.flat();

    // Sort by updated_at descending
    results.sort((a, b) => Date.parse(b.updated_at) - Date.parse(a.updated_at));

    return { sessions: results, errors: errors as any };
  };
}

function createListServiceFromConfig(config: Config): ListService {
  const registry = createAdapterRegistry(config, createAllAgentFactories(process.cwd()));

  return createListService(registry);
}

function createDetailService(config: Config): DetailService {
  const registry = createAdapterRegistry(config, createAllAgentFactories(process.cwd()));

  return async (query) => {
    const adapter = registry.adapters.find(
      (a) => a.agent === query.agent && a.alias === query.alias
    );

    if (!adapter || !adapter.getSessionDetail) {
      return null;
    }

    return adapter.getSessionDetail(query.id, {});
  };
}

function createExportService(config: Config): ExportService {
  const registry = createAdapterRegistry(config, createAllAgentFactories(process.cwd()));

  return async (query, options) => {
    const adapter = registry.adapters.find(
      (a) => a.agent === query.agent && a.alias === query.alias
    );

    if (!adapter || !adapter.getSessionDetail) {
      return null;
    }

    return adapter.getSessionDetail(query.id, options ?? {});
  };
}

function createSimilarService(config: Config): SimilarService {
  const registry = createAdapterRegistry(config, createAllAgentFactories(process.cwd()));

  return async (query, topK) => {
    const adapter = registry.adapters.find(
      (a) => a.agent === query.agent && a.alias === query.alias
    );

    if (!adapter) {
      throw new Error(`[${query.agent}:${query.alias}] not configured`);
    }
    return requireCapability(adapter, "findSimilarSessions", "similar")(query.id, topK);
  };
}

/**
 * BUG-7: Probe enabled adapters to find which one owns a session id, so
 * `oas similar <bare-id>` routes to the owning agent (e.g. codex) instead of
 * always erroring on opencode. Returns undefined when the id resolves nowhere.
 */
function createSimilarOwnerResolver(config: Config): SimilarOwnerResolver | undefined {
  const registry = createAdapterRegistry(config, createAllAgentFactories(process.cwd()));
  const probes = registry.adapters.filter((a) => a.getSessionDetail);
  if (probes.length === 0) return undefined;
  return async (sessionId: string) => {
    for (const adapter of probes) {
      try {
        // getSessionDetail is async — must await before truthiness check.
        const detail = await adapter.getSessionDetail!(sessionId, {});
        if (detail) {
          return { agent: adapter.agent, alias: adapter.alias };
        }
      } catch (error) {
        // session-not-found → try the next adapter; other errors also just
        // mean "cannot confirm ownership here" — never abort routing.
        continue;
      }
    }
    return undefined;
  };
}

function createCloneServiceFromConfig(config: Config) {
  const cwd = process.cwd();
  
  const registry: CloneRegistry = {
    getSource: (source) => {
      if (source.agent !== "codex" || !source.alias) {
        return undefined;
      }
      
      const entry = config.agents.find(
        (e) => e.agent === "codex" && e.alias === source.alias && e.enabled
      );
      
      if (!entry) {
        return undefined;
      }
      
      return createCodexCloneSourceAdapter(entry as any, { cwd });
    },
    
    getDestination: (destination) => {
      if (destination.agent !== "opencode") {
        return undefined;
      }
      
      const entry = config.agents.find(
        (e) => e.agent === "opencode" && e.alias === destination.alias && e.enabled
      );
      
      if (!entry) {
        return undefined;
      }
      
      return createOpenCodeCloneDestinationAdapter(entry as any, { cwd });
    },
    
    listSources: (agent) => {
      if (agent !== "codex") return [];
      return config.agents
        .filter((e) => e.agent === "codex" && e.enabled)
        .map((e) => e.alias);
    },
    
    listDestinations: (agent) => {
      if (agent !== "opencode") return [];
      return config.agents
        .filter((e) => e.agent === "opencode" && e.enabled)
        .map((e) => e.alias);
    },
  };
  
  return createCloneService(registry);
}

// ============================================================================
// Argument Parsing
// ============================================================================

function parseArgs(argv: string[]): ParsedArgs {
  const result = parseCliArgs(argv);
  if (!result.ok) {
    console.error(`Error: ${result.error}`);
    process.exit(2);
  }
  return result.value;
}

// ============================================================================
// Command Handlers
// ============================================================================

async function handleSessionsCommand(parsed: ParsedArgs): Promise<void> {
  // Validate --limit is a number when provided
  if (parsed.options["limit"] !== undefined) {
    const limit = parsed.options["limit"];
    if (typeof limit !== "number" || isNaN(limit)) {
      console.error("Invalid --limit value: must be a number");
      process.exit(1);
    }
  }

  // Validate --format is either "text" or "json" when provided
  if (parsed.options["format"] !== undefined) {
    const format = parsed.options["format"];
    if (format !== "text" && format !== "json") {
      console.error("Invalid --format value: must be 'text' or 'json'");
      process.exit(1);
    }
  }

  const config = loadConfig();
  const getSessions = createSessionsService(config);

  const result = await runSessionsCommand({
    last: parsed.options["last"] as string | undefined,
    since: parsed.options["since"] as string | undefined,
    until: parsed.options["until"] as string | undefined,
    limit: parsed.options["limit"] as number | undefined,
    format: parsed.options["format"] as "text" | "json" | undefined,
    full: parsed.options["full"] === true,
    showAlias: parsed.options["show-alias"] === true,
    agent: parsed.options["agent"] as string | undefined,
    alias: parsed.options["alias"] as string | undefined,
    config,
    getSessions,
  });

  await writeOut(result.stdout, result.stderr, result.exitCode);
}

async function handleReadCommand(parsed: ParsedArgs): Promise<void> {
  // Validate --first is a number when provided
  if (parsed.options["first"] !== undefined) {
    const first = parsed.options["first"];
    if (typeof first !== "number" || isNaN(first)) {
      console.error("Invalid --first value: must be a number");
      process.exit(1);
    }
  }

  // Validate --last is a number when provided
  if (parsed.options["last"] !== undefined) {
    const last = parsed.options["last"];
    if (typeof last !== "number" || isNaN(last)) {
      console.error("Invalid --last value: must be a number");
      process.exit(1);
    }
  }

  // Validate --format is one of the allowed values when provided
  if (parsed.options["format"] !== undefined) {
    const format = parsed.options["format"];
    if (!["text", "json", "csf", "markdown", "md"].includes(String(format))) {
      console.error("Invalid --format value: must be text, json, csf, markdown, or md");
      process.exit(1);
    }
  }

  const config = loadConfig();
  const getSession = createReadService(config);

  // Support positional session-id: `oas read <session-id>`
  // parseArgs stores first non-flag arg as .command, not .positional[0]
  const sessionSpec = parsed.options["session"] as string | undefined ?? parsed.positional[0] ?? parsed.command;

  const result = await runReadCommand({
    session: sessionSpec,
    agent: parsed.options["agent"] as string | undefined,
    alias: parsed.options["alias"] as string | undefined,
    id: parsed.options["id"] as string | undefined,
    first: parsed.options["first"] as number | undefined,
    last: parsed.options["last"] as number | undefined,
    all: parsed.options["all"] as boolean | undefined,
    range: parsed.options["range"] as string | undefined,
    userOnly: parsed.options["user-only"] as boolean | undefined,
    tools: parsed.options["tools"] as boolean | undefined,
    verbose: parsed.options["verbose"] as boolean | undefined,
    role: parsed.options["role"] as string | undefined,
    format: parsed.options["format"] as "text" | "json" | "csf" | "markdown" | "md" | undefined,
    output: parsed.options["output"] as string | undefined,
    config,
    getSession,
  });

  await writeOut(result.stdout, result.stderr, result.exitCode);
}

async function handleSearchCommand(parsed: ParsedArgs): Promise<void> {
  if (parsed.options["format"] !== undefined) {
    const format = parsed.options["format"];
    if (format !== "text" && format !== "json") {
      console.error("Invalid --format value: must be 'text' or 'json'");
      process.exit(1);
    }
  }

  const config = loadConfig();
  const searchSessions = createSearchService(config);

  const result = await runSearchCommand({
    text: parsed.options["text"] as string | undefined,
    format: parsed.options["format"] as "text" | "json" | undefined,
    agent: parsed.options["agent"] as string | undefined,
    alias: parsed.options["alias"] as string | undefined,
    config,
    searchSessions,
  });

  await writeOut(result.stdout, result.stderr, result.exitCode);
}

async function handleListNewCommand(parsed: ParsedArgs): Promise<void> {
  const config = loadConfig();
  const list = createListServiceFromConfig(config);

  const result = await runListCommand({
    agent: parsed.options["agent"] as string | undefined,
    alias: parsed.options["alias"] as string | undefined,
    q: parsed.options["q"] as string | undefined,
    limit: parsed.options["limit"] as number | undefined,
    rootsOnly: parsed.options["roots-only"] === true,
    subOnly: parsed.options["sub-only"] === true,
    childrenOf: parsed.options["children-of"] as string | undefined,
    includeSubagents: parsed.options["include-subagents"] === true,
    full: parsed.options["full"] === true,
    showAlias: parsed.options["show-alias"] === true,
    format: parsed.options["format"] as "text" | "json" | undefined,
    config,
    list,
  });

  await writeOut(result.stdout, result.stderr, result.exitCode);
}

async function handleDetailCommand(parsed: ParsedArgs): Promise<void> {
  if (parsed.options["format"] !== undefined) {
    const format = parsed.options["format"];
    if (format !== "text" && format !== "json") {
      console.error("Invalid --format value: must be 'text' or 'json'");
      process.exit(1);
    }
  }

  const config = loadConfig();
  const getSession = createDetailService(config);

  // Support positional session spec: `oas detail <session-id>`
  // parseArgs stores first non-flag arg as command (not positional), so also use parsed.command
  const sessionSpec =
    parsed.options["session"] as string | undefined ||
    parsed.positional[0] ||
    parsed.command || undefined;

  // BUG-10 companion: a bare session-id must resolve against ALL enabled
  // adapters (a codex id should route to codex), not just the first enabled
  // agent/alias. Reuses the same owner-probing pattern as `oas similar`
  // (BUG-7). Explicit --session/--agent/--alias/--id specs are untouched.
  const bareId = sessionSpec && !sessionSpec.includes(":") ? sessionSpec : undefined;
  const resolveSessionOwner = bareId
    ? createSimilarOwnerResolver(config)
    : undefined;

  const result = await runDetailCommand({
    session: sessionSpec,
    agent: parsed.options["agent"] as string | undefined,
    alias: parsed.options["alias"] as string | undefined,
    id: parsed.options["id"] as string | undefined,
    format: parsed.options["format"] as "text" | "json" | undefined,
    config,
    getSession,
    resolveSessionOwner,
  });

  await writeOut(result.stdout, result.stderr, result.exitCode);
}

async function handleCloneCommand(parsed: ParsedArgs): Promise<void> {
  const config = loadConfig();
  const clone = createCloneServiceFromConfig(config);

  const result = await runCloneCommand({
    from: parsed.options["from"] as string | undefined,
    to: parsed.options["to"] as string | undefined,
    config,
    clone,
  });

  await writeOut(result.stdout, result.stderr, result.exitCode);
}

async function handleExportCommand(restArgs: string[]): Promise<void> {
  const config = loadConfig();
  const getSession = createExportService(config);

  const fr = parseExportFlags(restArgs);
  if (!fr.ok) {
    await writeOut("", fr.errors.join("\n") + "\n", fr.exitCode);
  }
  const flags = fr.value;

  const result = await runExportCommand({
    sessionRef: flags.sessionRef,
    from: flags.from,
    format: flags.format,
    output: flags.output,
    // dir-mode (turn split/consolidate) surface:
    agent: flags.agent,
    id: flags.id,
    type: flags.type,
    dir: flags.dir,
    prefix: flags.prefix,
    dryRun: flags.dryRun,
    force: flags.force,
    fromRelative: flags.fromRelative,
    toRelative: flags.toRelative,
    fromTurn: flags.fromTurn,
    toTurn: flags.toTurn,
    withTypes: flags.withTypes,
    rawWithFlags: flags.rawWithFlags,
    config,
    getSession,
  });

  await writeOut(result.stdout, result.stderr, result.exitCode);
}

async function handleSimilarCommand(parsed: ParsedArgs): Promise<void> {
  // Positional: oas similar <session-id>
  // parseArgs stores first non-flag arg as .command, not .positional[0]
  const sessionId = parsed.positional[0] ?? parsed.command;
  if (!sessionId) {
    console.error("Usage: oas similar <session-id> [--top N] [--format json|text]");
    process.exit(1);
  }

  // Parse --top / -n (default 5)
  const topK = parsed.options["top"] as number | undefined;
  if (topK !== undefined && (typeof topK !== "number" || isNaN(topK))) {
    console.error("Invalid --top value: must be a number");
    process.exit(1);
  }

  // Parse --format
  const format = parsed.options["format"] as string | undefined;
  if (format !== undefined && format !== "text" && format !== "json") {
    console.error("Invalid --format value: must be 'text' or 'json'");
    process.exit(1);
  }

  const config = loadConfig();
  const findSimilar = createSimilarService(config);
  const resolveSessionOwner = createSimilarOwnerResolver(config);

  const result = await runSimilarCommand({
    sessionId,
    top: topK,
    format: format as "text" | "json" | undefined,
    config,
    findSimilar,
    resolveSessionOwner,
  });

  await writeOut(result.stdout, result.stderr, result.exitCode);
}

function requireHierarchyOptions(parsed: ParsedArgs, command: string): {
  session: string; format: "text" | "json" | undefined;
  agent: string | undefined; alias: string | undefined;
} {
  const session = parsed.command || parsed.positional[0] || parsed.options["session"];
  if (typeof session !== "string" || session.length === 0) {
    console.error("Usage: oas session " + command + " <session-id> [--format text|json] [--agent NAME] [--alias NAME]");
    process.exit(1);
  }
  const format = parsed.options["format"];
  if (format !== undefined && format !== "text" && format !== "json") {
    console.error("Invalid --format value: must be 'text' or 'json'");
    process.exit(1);
  }
  const agent = parsed.options["agent"];
  const alias = parsed.options["alias"];
  if ((agent !== undefined && typeof agent !== "string") ||
      (alias !== undefined && typeof alias !== "string")) {
    console.error("--agent and --alias require string values");
    process.exit(1);
  }
  return { session, format: format as "text" | "json" | undefined,
    agent: agent as string | undefined, alias: alias as string | undefined };
}

async function handleTreeCommand(parsed: ParsedArgs): Promise<void> {
  const opts = requireHierarchyOptions(parsed, "tree");
  const config = loadConfig();
  const registry = createAdapterRegistry(config, createAllAgentFactories(process.cwd()));
  const result = await runTreeCommand({
    session: opts.session, format: opts.format, config,
    getForkChain: createTreeService(registry, { agent: opts.agent, alias: opts.alias }),
  });
  await writeOut(result.stdout, result.stderr, result.exitCode);
}

async function handleChildrenCommand(parsed: ParsedArgs): Promise<void> {
  const opts = requireHierarchyOptions(parsed, "children");
  const config = loadConfig();
  const registry = createAdapterRegistry(config, createAllAgentFactories(process.cwd()));
  const result = await runChildrenCommand({
    parentSessionId: opts.session, format: opts.format, config,
    getChildren: createChildrenService(registry, { agent: opts.agent, alias: opts.alias }),
  });
  await writeOut(result.stdout, result.stderr, result.exitCode);
}

