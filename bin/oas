  console.log("  oas session read abc123 --last 20    Last 20 messages");
  console.log("  oas session detail abc123            Show session details");
  console.log("  oas session export abc123 -f markdown  Export as markdown");
  console.log("  oas session clone --from codex:100 --to opencode:default");
  console.log("  oas session search --text \"error\"   Search for 'error'");
  console.log("  oas session similar abc123           Find similar sessions");
  process.exit(0);
}

// ============================================================================
// TUI Command (R-15)
// ============================================================================

async function handleTuiCommand(): Promise<void> {
  const config = loadConfig();

  // Create CLI-compatible services for the TUI
  const listService = createListServiceFromConfig(config);
  const getSessionService = createDetailService(config);
  const cloneService = createCloneServiceFromConfig(config);

  // Map CLI service signatures to TUI service signatures
  const tuiListService: TuiListService = async (query) => {
    return listService(query as any);
  };

  const tuiDetailService: TuiDetailService = async (query) => {
    return getSessionService(query as any);
  };

  const tuiCloneService: TuiCloneService = async (request) => {
    return cloneService(request as any);
  };

  try {
    await runTuiApp({
      config,
      list: tuiListService,
      getSession: tuiDetailService,
      cloneSession: tuiCloneService,
    });
  } catch (error) {
    console.error("TUI error:", error instanceof Error ? error.message : String(error));
    console.error("Stack:", error instanceof Error ? error.stack : "");
    process.exit(1);
  }
}

// ============================================================================
// Main
// ============================================================================

// ============================================================================
// Deprecated Shim Helper
// ============================================================================

function deprecationNotice(newCmd: string): void {
  process.stderr.write(`DEPRECATED: use '${newCmd}' instead.\n`);
}

// ============================================================================
// Session Subcommand Router
// ============================================================================

/**
 * Routes `oas session <subcommand>` to the correct handler.
 * Bare `oas session` defaults to `oas session list`.
 *
 * `oas session list` is ONE command with ALL flags.
 * When --last/--since/--until are present → routes to handleSessionsCommand (time-range).
 * Otherwise → routes to handleListNewCommand (agent/alias/q filtering).
 */
async function handleSessionCommand(subArgs: string[]): Promise<void> {
  // Bare `oas session` or `oas session --help` → default to list
  if (subArgs.length === 0 || subArgs[0] === "--help" || subArgs[0] === "-h") {
    // Default to session list
    const listArgs = subArgs.length === 0 ? [] : subArgs;
    await handleSessionListSubcommand(listArgs);
    return;
  }

  const subcommand = subArgs[0];
  const restArgs = subArgs.slice(1);

  switch (subcommand) {
    case "list":
      await handleSessionListSubcommand(restArgs);
      return;

    case "read": {
      const parsed = parseArgs(restArgs);
      if (parsed.options["help"] || parsed.options["h"]) { showHelp(); return; }
      await handleReadCommand(parsed);
      return;
    }

    case "detail": {
      // Support: oas session detail <session-spec> [flags]
      const parsed = parseArgs(restArgs);
      if (parsed.options["help"] || parsed.options["h"]) { showHelp(); return; }
      await handleDetailCommand(parsed);
      return;
    }

    case "export": {
      const parsed = parseArgs(restArgs);
      if (parsed.options["help"] || parsed.options["h"]) { showHelp(); return; }
      await handleExportCommand(parsed);
      return;
    }

    case "clone": {
      const parsed = parseArgs(restArgs);
      if (parsed.options["help"] || parsed.options["h"]) { showHelp(); return; }
      await handleCloneCommand(parsed);
      return;
    }

    case "search": {
      const parsed = parseArgs(restArgs);
      if (parsed.options["help"] || parsed.options["h"]) { showHelp(); return; }
      await handleSearchCommand(parsed);
      return;
    }

    case "similar": {
      const parsed = parseArgs(restArgs);
      if (parsed.options["help"] || parsed.options["h"]) { showHelp(); return; }
      await handleSimilarCommand(parsed);
      return;
    }

    default:
      console.error(`Unknown session subcommand: ${subcommand}`);
      console.error("Run 'oas session --help' for available subcommands.");
      process.exit(1);
  }
}

/**
 * `oas session list` — ONE command, ALL flags.
 * Routes to time-range handler when --last/--since/--until present.
 * Otherwise routes to the filter-based handler (agent/alias/q/roots/sub/children).
 */
async function handleSessionListSubcommand(args: string[]): Promise<void> {
  const parsed = parseArgs(args);
  if (parsed.options["help"] || parsed.options["h"]) {
    showHelp();
    return;
  }

  // Validate --limit if provided as flag
  const limitVal = parsed.options["limit"];
  if (limitVal !== undefined) {
    if (limitVal === true) {
      console.error("Error: --limit requires a value");
      process.exit(1);
    }
    const limitNum = Number(limitVal);
    if (isNaN(limitNum) || limitNum < 0 || !Number.isInteger(limitNum)) {
      console.error(`Error: --limit must be a non-negative integer, got: ${limitVal}`);
      process.exit(1);
    }
  }

  // Detect time-range flags → route to sessions handler
  const hasTimeFlags = parsed.options["last"] !== undefined
    || parsed.options["since"] !== undefined
    || parsed.options["until"] !== undefined;

  // Convert --limit 0 to "all results" (undefined) for the list-new path.
  // The sessions (time-range) path already handles limit 0 → MAX_LIST_LIMIT internally.
  if (!hasTimeFlags && parsed.options["limit"] === 0) {
    delete parsed.options["limit"];
  }

  if (hasTimeFlags) {
    // Route to sessions handler — it handles --last/--since/--until/--limit/--format/--full/--show-alias
    await handleSessionsCommand(parsed);
  } else {
    // Route to list handler — it handles --agent/--alias/--q/--roots-only/--sub-only/--children-of/--limit/--format/--full/--show-alias
    // Also handle positional limit: `oas session list 20`
    const limitArg = parsed.positional[0] || (parsed.command ? parsed.command : undefined);
    if (limitArg !== undefined) {
      const num = Number(limitArg);
      // Positional 0 means "all results" — skip setting limit
      if (num === 0 && Number.isInteger(num)) {
        // Don't pass limit to the list service — returns all sessions
      } else if (isNaN(num) || num < 0 || !Number.isInteger(num)) {
        console.error(`Error: limit must be a non-negative integer, got: ${limitArg}`);
        process.exit(1);
      } else {
        // Wire the positional limit into options so handleListNewCommand sees it
        parsed.options["limit"] = num;
      }
    }
    await handleListNewCommand(parsed);
  }
}

// ============================================================================
// Main
// ============================================================================

async function main() {
  const argv = process.argv.slice(2);
  
  if (argv.length === 0 || argv[0] === "--help" || argv[0] === "-h") {
    showHelp();
    return;
  }

  const command = argv[0];
  const restArgs = argv.slice(1);

  // ========================================================================
  // NEW: `oas session <subcommand>` — primary command structure
  // ========================================================================
  if (command === "session") {
    await handleSessionCommand(restArgs);
    return;
  }

  // ========================================================================
  // Top-level commands (non-session)
  // ========================================================================

  // R-13: Config inspection command
  if (command === "config") {
    const result = await runConfigCommand(restArgs);
    process.stdout.write(result.stdout);
    process.stderr.write(result.stderr);
    process.exit(result.exitCode);
  }

  if (command === "onboard") {
    const proc = Bun.spawn(["bd", "onboard"], {
      stdout: "inherit",
      stderr: "inherit",
    });
    const exitCode = await proc.exited;
    process.exit(exitCode);
    return;
  }

  // TUI command (R-15)
  if (command === "tui") {
    await handleTuiCommand();
    return;
  }

  // ========================================================================
  // DEPRECATED SHIMS — old commands forward to new `oas session <subcmd>`
  // ========================================================================

  if (command === "list" || command === "recent") {
    deprecationNotice("oas session list");
    await handleSessionListSubcommand(restArgs);
    return;
  }

  if (command === "sessions") {
    deprecationNotice("oas session list");
    const parsed = parseArgs(restArgs);
    if (parsed.options["help"] || parsed.options["h"]) { showHelp(); return; }
    // Route directly to sessions handler — it applies 24h default via parseTimeRange
    await handleSessionsCommand(parsed);
    return;
  }

  if (command === "list-new") {
    deprecationNotice("oas session list");
    const parsed = parseArgs(restArgs);
    if (parsed.options["help"] || parsed.options["h"]) { showHelp(); return; }
    await handleListNewCommand(parsed);
    return;
  }

  if (command === "find" || command === "show") {
    deprecationNotice("oas session detail");
    const sessionId = restArgs[0];
    if (!sessionId || sessionId === "--help" || sessionId === "-h") {
      console.error("Usage: oas session detail <session-id>");
      process.exit(1);
    }
    // Route to detail handler instead of legacy findSession()
    const parsed = parseArgs(restArgs);
    await handleDetailCommand(parsed);
    return;
  }

  if (command === "detail") {
    deprecationNotice("oas session detail");
    const parsed = parseArgs(restArgs);
    if (parsed.options["help"] || parsed.options["h"]) { showHelp(); return; }
    await handleDetailCommand(parsed);
    return;
  }

  if (command === "read") {
    deprecationNotice("oas session read");
    const parsed = parseArgs(restArgs);
    if (parsed.options["help"] || parsed.options["h"]) { showHelp(); return; }
    await handleReadCommand(parsed);
    return;
  }

  if (command === "search") {
    deprecationNotice("oas session search");
    const parsed = parseArgs(restArgs);
    if (parsed.options["help"] || parsed.options["h"]) { showHelp(); return; }
    await handleSearchCommand(parsed);
    return;
  }

  if (command === "clone") {
    deprecationNotice("oas session clone");
    const parsed = parseArgs(restArgs);
    if (parsed.options["help"] || parsed.options["h"]) { showHelp(); return; }
    await handleCloneCommand(parsed);
    return;
  }

  if (command === "export") {
    deprecationNotice("oas session export");
    const parsed = parseArgs(restArgs);
    if (parsed.options["help"] || parsed.options["h"]) { showHelp(); return; }
    await handleExportCommand(parsed);
    return;
  }

  if (command === "similar") {
    deprecationNotice("oas session similar");
    const parsed = parseArgs(restArgs);
    if (parsed.options["help"] || parsed.options["h"]) { showHelp(); return; }
    await handleSimilarCommand(parsed);
    return;
  }

  // Unknown command
  console.error(`Unknown command: ${command}`);
  console.error("Run 'oas --help' for available commands.");
  process.exit(1);
}

main().catch((error) => {
  console.error("Error:", error instanceof Error ? error.message : String(error));
  process.exit(1);
});
