#!/usr/bin/env bash
# =============================================================================
# pre-commit-guard — open-agent-sessions project hook
#
# ⚠️  DO NOT EDIT THIS FILE MANUALLY.
#     Changes to rules go in: references/rules.md
#     Changes to ast-grep patterns go in: ast-grep/rules/dry-rules.yml
#
# pre-commit-guard 2026-04-18
# =============================================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$REPO_DIR"

PRECOMMIT_GUARD_VERSION="2026-04-18"

# =============================================================================
# Identity stamp check
# =============================================================================

STAMP_LINE=$(grep -m1 "^# pre-commit-guard" "$0" 2>/dev/null || echo "")
if [ -z "$STAMP_LINE" ]; then
  echo "⚠ pre-commit-guard: missing identity stamp in $0"
  echo "  → Add '# pre-commit-guard $PRECOMMIT_GUARD_VERSION' as first line"
  exit 0
fi

# =============================================================================
# Detect replay mode
# =============================================================================

REPLAY_MODE="0"
REPLAY_COMMIT=""
if [ "${1:-}" = "--replay" ]; then
  REPLAY_MODE="1"
  REPLAY_COMMIT="${2:-HEAD}"
  echo "[pre-commit-guard --replay] Replaying rules against: $REPLAY_COMMIT"
  echo "─────────────────────────────────────────────────────────────"
fi

echo "=== pre-commit-guard $PRECOMMIT_GUARD_VERSION ==="

# =============================================================================
# Helper: run a single rule
# =============================================================================

run_rule() {
  local id="$1"
  local severity="$2"
  local name="$3"
  local check="$4"
  local note="$5"

  # R-01 is skip-check for replay mode
  if [ "$REPLAY_MODE" = "1" ] && [ "$id" = "R-01" ]; then
    echo "  ✓ $id $name"
    return 0
  fi

  local result
  result=$(eval "$check" 2>/dev/null | head -20 || true)

  if [ -n "$result" ]; then
    if [ "$severity" = "fail" ]; then
      echo "  ✗ $id $name"
      echo "    $result" | head -5 | sed 's/^/      /'
      FAILED=$((FAILED + 1))
    else
      echo "  WARN $id $name"
      echo "    $result" | head -5 | sed 's/^/      /'
      WARNED=$((WARNED + 1))
    fi
  else
    echo "  ✓ $id $name"
    PASSED=$((PASSED + 1))
  fi
}

FAILED=0
WARNED=0
PASSED=0

# =============================================================================
# Default rules
# =============================================================================

# R-01: hook executable — bypass eval so we can use $0 reliably
if bash -c '[ -x "$0" ]' "$SCRIPT_DIR/pre-commit" 2>/dev/null; then
  echo "  ✓ R-01 hook-executable"
  PASSED=$((PASSED + 1))
else
  echo "  ✗ R-01 hook-executable"
  echo "    chmod +x .git/hooks/pre-commit"
  FAILED=$((FAILED + 1))
fi

# R-02: no .env files staged
run_rule "R-02" "fail" "no-env-files" \
  'STAGED=$(git --no-pager diff --cached --name-only | grep -E "\.env(\.|$)") && [ -n "$STAGED" ] && echo "staged: $STAGED" || echo ""' \
  ""

# R-03: no binary files
run_rule "R-03" "warn" "no-binary-files" \
  'git --no-pager diff --cached --name-only | xargs -I{} file {} 2>/dev/null | grep -v "text" | grep -v "empty" | cut -d: -f1 | head -5 || true' \
  ""

# R-04: ast-grep dry patterns
run_rule "R-04" "warn" "ast-grep-dry-warn" \
  'bash scripts/pre-commit-ast-dry.sh warn 2>/dev/null | head -20 || true' \
  "See ast-grep/rules/dry-rules.yml for full DRY pattern definitions."

# R-05: no direct readFileSync("utf-8") in adapter code
run_rule "R-05" "warn" "no-direct-readFileSync-utf8" \
  'git --no-pager diff --cached --name-only -- "*.ts" | xargs grep -Hn "readFileSync.*\"utf-8\"" 2>/dev/null | grep -v "fs-utils" | grep -v "src/config" | grep -v "\.test\.ts" | grep -v "bin/oas" | head -10 || true' \
  "Use fs-utils.ts: readJsonFile(path) or readTextFile(path) — see references/rules.md R-05"

# R-06: no direct readdirSync + filter(".json") in adapter code
run_rule "R-06" "warn" "no-direct-readdirSync-json" \
  'git --no-pager diff --cached --name-only -- "*.ts" | xargs grep -Hn "readdirSync.*\.endsWith.*json" 2>/dev/null | grep -v "fs-utils" | grep -v "\.test\.ts" | head -10 || true' \
  "Use fs-utils.ts: listJsonFiles(dir) — see references/rules.md R-06"

# R-07: no direct statSync + isFile/isDirectory guard (opencode retry loop is exempt)
run_rule "R-07" "warn" "no-direct-statSync-isFile" \
  'git --no-pager diff --cached --name-only -- "*.ts" | xargs grep -Hn "statSync" 2>/dev/null | grep -v "fs-utils" | grep -v "safeStat" | grep -v "\.test\.ts" | grep -v "opencode.ts:244" | head -10 || true' \
  "Use fs-utils.ts: safeStat(path) — see references/rules.md R-07"

# R-08: no inline Date.parse for timestamp comparison
run_rule "R-08" "warn" "no-inline-date-parse-sort" \
  'git --no-pager diff --cached --name-only -- "*.ts" | xargs grep -Hn "Date\.parse" 2>/dev/null | grep -v "fs-utils" | grep -v "\.test\.ts" | grep -v "normalize" | head -10 || true' \
  "Use fs-utils.ts: minIso(a,b), maxIso(a,b), sortByIso(arr) — see references/rules.md R-08"

# R-09: no inline toLowerCase().includes()
run_rule "R-09" "warn" "no-inline-toLowerCase-includes" \
  'git --no-pager diff --cached --name-only -- "*.ts" | xargs grep -Hn "\.toLowerCase()\.includes(" 2>/dev/null | grep -v "fs-utils" | grep -v "\.test\.ts" | grep -v "planner" | grep -v "src/cli" | head -10 || true' \
  "Use fs-utils.ts: containsIgnoreCase(text, pattern) — see references/rules.md R-09"

# R-10: no inline JSONL line splitting (split(/\r?\n/)) in adapters
run_rule "R-10" "warn" "no-inline-jsonl-line-split" \
  'git --no-pager diff --cached --name-only -- "src/adapters/*.ts" | xargs grep -Hn "split.*\\\\\\\\r\?\\\\\\\\n" 2>/dev/null | grep -v "jsonl-utils" | grep -v "\.test\.ts" | head -10 || true' \
  "Use src/adapters/jsonl-utils.ts: splitJsonlLines(content) — see references/rules.md R-10"

# R-11: no inline content extraction (extractContentText/extractContentParts) in adapters
run_rule "R-11" "warn" "no-inline-content-extraction" \
  'git --no-pager diff --cached --name-only -- "src/adapters/*.ts" | xargs grep -Hn "extractContentText\|extractContentParts" 2>/dev/null | grep -v "content-utils" | grep -v "\.test\.ts" | head -10 || true' \
  "Use src/adapters/content-utils.ts: extractContentText(), extractContentParts() — see references/rules.md R-11"

# R-12: no duplicate path resolution (expandTilde) in config/load.ts
run_rule "R-12" "warn" "no-duplicate-expandTilde" \
  'git --no-pager diff --cached --name-only -- "src/config/load.ts" | xargs grep -Hn "expandTilde\|homedir()\|pathValue.startsWith" 2>/dev/null | grep -v "from.*fs-utils" | head -10 || true' \
  "config/load.ts: import expandTilde from fs-utils.ts instead of re-implementing — see references/rules.md R-12"

# R-13: no duplicate label construction (${agent}:${alias}) in adapters
run_rule "R-13" "warn" "no-duplicate-label-construction" \
  'git --no-pager diff --cached --name-only -- "src/adapters/*.ts" | xargs grep -Hn "agent.*alias|alias.*agent" 2>/dev/null | grep -v "createLabel\|label.*template" | grep -v "\.test\.ts" | head -10 || true' \
  "Use src/adapters/label.ts: createLabel(entry) — see references/rules.md R-13"

# =============================================================================
# Summary
# =============================================================================

echo "─────────────────────────────────────────────────────────────"
echo "  $PASSED passed  $WARNED warned  $FAILED failed"

if [ "$FAILED" -gt 0 ]; then
  echo "  → Fix failures before committing"
  echo "  → See references/rules.md for duplication policy and helpers"
  exit 1
fi

if [ "$WARNED" -gt 0 ]; then
  echo "  ⚠ warnings issued — use fs-utils.ts helpers:"
  echo "    • readJsonFile(path)   — safe JSON parse, returns null on error"
  echo "    • listJsonFiles(dir)   — safe *.json directory listing"
  echo "    • safeStat(path)       — null on error instead of throwing"
  echo "    • minIso(a,b) / maxIso(a,b) — timestamp comparison"
  echo "    • containsIgnoreCase(text, needle) — case-insensitive search"
  echo "  → See references/rules.md §R-05 through §R-09"
fi

exit 0