{
  "name": "open-agent-sessions",
  "version": "0.1.0",
  "description": "Unified session management library for AI coding agents (OpenCode, Codex, Claude)",
  "type": "module",
  "main": "./src/index.ts",
  "workspaces": [
    "packages/*",
    "oas-command-stats"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./sdk": "./src/sdk/index.ts",
    "./adapters": "./src/adapters/index.ts",
    "./adapters/opencode": "./src/adapters/opencode.ts",
    "./adapters/codex": "./src/adapters/codex.ts",
    "./adapters/claude": "./src/adapters/claude.ts",
    "./adapters/acpx": "./src/adapters/acpx.ts",
    "./adapters/gemini": "./src/adapters/gemini.ts",
    "./adapters/antigravity": "./src/adapters/antigravity.ts",
    "./types": "./src/types/index.ts"
  },
  "bin": {
    "oas": "./bin/oas"
  },
  "scripts": {
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:coverage:core": "bun test --coverage --coverage-exclude='src/tui/**'",
    "build": "bun build ./src/index.ts --outdir ./dist --target node",
    "typecheck": "tsc --noEmit",
    "test:sdk-contract": "bun run --cwd packages/sdk build && tsc -p test/sdk/tsconfig.contract.json --noEmit && bun test test/sdk/public-contract.test.ts --no-coverage"
  },
  "keywords": [
    "ai",
    "agent",
    "sessions",
    "opencode",
    "codex",
    "claude",
    "session-management",
    "ai-tools"
  ],
  "author": "open-agent-sessions contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/buihongduc132/open-agent-sessions.git"
  },
  "bugs": {
    "url": "https://github.com/buihongduc132/open-agent-sessions/issues"
  },
  "homepage": "https://github.com/buihongduc132/open-agent-sessions#readme",
  "engines": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@opentui/core": "^0.1.74",
    "@opentui/react": "^0.1.74",
    "liqe": "^3.8.5",
    "quick-lru": "^7.3.0",
    "react": "^19.2.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.8",
    "bun-types": "^1.3.10",
    "duckdb": "^1.4.4",
    "sh-syntax": "^0.6.0",
    "typescript": "^5.4.5"
  }
}
